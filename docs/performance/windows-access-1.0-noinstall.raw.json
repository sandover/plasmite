  "validation_script": "import json\nimport pathlib\nimport sys\n\nroot = pathlib.Path(__file__).resolve().parent\nsys.path.insert(0, str(root/'scripts'))\nfrom bench_transport_comparison import HttpsMcp, serialized_payload, summary\nimport time\n\ndef prohibit_native_client(event, args):\n    if event == 'subprocess.Popen':\n        raise RuntimeError('No-install MCP check prohibits child processes')\n    if event == 'import' and args[0] == 'plasmite':\n        raise RuntimeError('No-install MCP check prohibits native Plasmite imports')\n\nsys.addaudithook(prohibit_native_client)\nmetadata=json.loads((root/'metadata.json').read_text())\nkey=json.loads((root/'access-key.json').read_text())['access_key']\nresult={'benchmark':'direct-mcp-no-install', 'proof':'Python audit hook rejects all child processes and imports of the plasmite module. Client uses standard-library HTTPS only.', 'python':sys.version, 'server':metadata, 'runs':[]}\nclient=HttpsMcp(metadata['server']+'/mcp',key,str(root/'ca.pem'))\ntry:\n    for size in [512,4096]:\n        warm=serialized_payload(size,0,0,'no-install')\n        message=client.tool('plasmite_feed',{'pool':'access-bench','data':warm,'create':False})['message']\n        assert client.tool('plasmite_fetch',{'pool':'access-bench','seq':message['seq']})['message']['data']==warm\n        for repeat in range(1,6):\n            data=[serialized_payload(size,repeat,i,'no-install') for i in range(100)]\n            seqs=[]; latencies=[]; started=time.perf_counter_ns()\n            for item in data:\n                before=time.perf_counter_ns()\n                message=client.tool('plasmite_feed',{'pool':'access-bench','data':item,'create':False})['message']\n                latencies.append(time.perf_counter_ns()-before);seqs.append(message['seq'])\n            append=summary(latencies,time.perf_counter_ns()-started)\n            latencies=[];started=time.perf_counter_ns()\n            for seq,item in zip(seqs,data,strict=True):\n                before=time.perf_counter_ns()\n                message=client.tool('plasmite_fetch',{'pool':'access-bench','seq':seq})['message']\n                latencies.append(time.perf_counter_ns()-before)\n                assert message['seq']==seq and message['data']==item\n            read=summary(latencies,time.perf_counter_ns()-started)\n            result['runs'].append({'payload_bytes':size,'repeat':repeat,'append':append,'read':read,'readback_verified':100})\nfinally:\n    client.close()\n(root/'access-windows-noinstall.raw.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint('Verified direct MCP while blocking all client subprocesses and native Plasmite imports.')\n",
